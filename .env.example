# .env 로 복사해서 쓰세요. .env 는 Git에 올리지 않아요.

# 로그인 토큰 서명 키 (32자 이상 아무 문자열)
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRE_MIN=480
# 로그 사번 가명화용 고정 키 (비워 두면 프로세스마다 임시 키를 사용)
PSEUDO_KEY=
# DB 대화 로그 저장 (기본 true, HRDB_URL이 없으면 무시)
CHAT_LOG_DB=

# 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173

# LLM 서버 (OpenAI 형식). 비워두면 가짜 LLM
#   Ollama: http://localhost:11434/v1  /  vLLM: http://127.0.0.1:8000/v1
LLM_BASE_URL=
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=
LLM_TIMEOUT=180
# 최대 답변 토큰 수
LLM_MAX_TOKENS=600

# 인사·규정 DB (PostgreSQL + pgvector). 비워두면 DB 없이 가짜 데이터로 동작
#   scripts/load_hrdb.py 를 실행하면 자동으로 채워져요
HRDB_URL=

# 규정 검색 방식: auto / keyword / vector / hybrid / rag
#   auto: sentence-transformers(BGE-M3)가 설치돼 있으면 hybrid, 없으면 keyword
#   rag : 옆 폴더의 rag 패키지(rag-main)로 검색. 설치: pip install -r ../rag-main/requirements.txt
SEARCH_MODE=auto
# rag 패키지 폴더 (비우면 backend 옆의 rag-main)
RAG_PATH=
# rag 검색에서 BGE-M3(Dense)를 쓸지: on / off. GPU 메모리가 작으면 off (BM25만 사용)
RAG_EMBED=on
# 검색 1위 점수가 이보다 낮으면 다시 검색하고, 그래도 낮으면 거절
VERIFY_MIN_SCORE=0.3

# 기준표 연차·시간외 계산 (기본 off)
CALC_TOOLS=off
# 기준표 경로 (기본 ..\DB\rules\rules.json)
RULES_PATH=..\DB\rules\rules.json

# DB를 안 쓸 때만: 규정 청크 파일 경로
RULES_CHUNKS_PATH=
